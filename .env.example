# Feishu app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Codex model
AGENT_BRIDGE_DEFAULT_CODEX_MODEL=gpt-5.3-codex
AGENT_BRIDGE_DEFAULT_CODEX_EFFORT=medium
AGENT_BRIDGE_DEFAULT_CODEX_ACCESS_MODE=default
AGENT_BRIDGE_LOG_LEVEL=normal

# Bot behavior
AGENT_BRIDGE_DEFAULT_WORKSPACE_ID=default
# Whether Feishu replies are streamed in real time.
# true  = stream card updates (default)
# false = send once after run completes
AGENT_BRIDGE_FEISHU_STREAMING_OUTPUT=true
# Whether normal assistant replies use Feishu CardKit element streaming.
# true  = smooth CardKit streaming card without the red header (default)
# false = use the legacy interactive card patch path
AGENT_BRIDGE_FEISHU_CARDKIT_STREAMING=true
# For long completed replies, keep this percentage visible when no explicit
# conclusion/summary section is detected. Allowed range: 5-50. Default: 10.
AGENT_BRIDGE_OUTPUT_VISIBLE_TAIL_PERCENT=10
# Temporarily fall back to legacy cards after CardKit errors, then retry automatically.
AGENT_BRIDGE_CARDKIT_FAILURE_COOLDOWN_MS=300000
# What to do with a normal message while the current Codex task is running:
# reject = explain that the task is still running (default)
# steer  = inject the message into the active task as guidance
AGENT_BRIDGE_ACTIVE_TURN_FOLLOW_UP_MODE=reject
# Release an Feishu thread when Codex never emits a terminal turn event.
# Set to 0 only when intentionally disabling the watchdog.
AGENT_BRIDGE_STALE_TURN_TIMEOUT_MS=900000

# Optional metadata-only append-only delivery receipt integration
AGENT_BRIDGE_DELIVERY_LEDGER_CLI=
AGENT_HUB_DELIVERY_LEDGER=

# Restrict which local directories can be bound from Feishu
# Comma-separated absolute paths. Leave empty to allow any absolute path.
AGENT_BRIDGE_WORKSPACE_ALLOWLIST=

# Default projects root used by the welcome/control card bind form.
# When a user binds a folder name (e.g. "my-repo"), it resolves to
# ${AGENT_BRIDGE_PROJECTS_ROOT}/my-repo. Defaults to ~/projects.
AGENT_BRIDGE_PROJECTS_ROOT=~/projects

# Restrict who can operate cards (buttons/menus/approval) by Feishu
# open_id / user_id, comma-separated. Leave empty to allow everyone.
AGENT_BRIDGE_CARD_ACTION_SENDER_ALLOWLIST=

# Optional explicit Codex endpoint. Leave empty to spawn `codex app-server`.
AGENT_BRIDGE_CODEX_ENDPOINT=

# ── 后端切换（可选）────────────────────────────────
# 统一用 AGENT_BRIDGE_BACKEND 指定后端：codex | opencode | claude | chuang | openclaw | hermes | grok
# 缺省走 Codex app-server。
# AGENT_BRIDGE_BACKEND=opencode
# opencode serve 地址（默认 http://127.0.0.1:4096）
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# opencode agent（默认 build，对应 opencode.json 里的 agent）
# OPENCODE_AGENT=build
# claude：CLAUDE_BRIDGE_BACKEND 已废弃，统一改 AGENT_BRIDGE_BACKEND=claude
# chuang：CHUANG_BRIDGE_BACKEND 已废弃，统一改 AGENT_BRIDGE_BACKEND=chuang
# OpenClaw/Hermes/Grok 可选命令路径：
# AGENT_BRIDGE_OPENCLAW_COMMAND=openclaw
# AGENT_BRIDGE_HERMES_COMMAND=hermes
# GROK_COMMAND=grok

# Optional session persistence location
AGENT_BRIDGE_SESSIONS_FILE=/Users/your-name/.codex-im/sessions.json

# Optional private attachment cache for Feishu/Lark image and file intake
AGENT_BRIDGE_ATTACHMENTS_DIR=/Users/your-name/.codex-feishu-bridge/attachments
AGENT_BRIDGE_MAX_IMAGE_BYTES=10485760
AGENT_BRIDGE_MAX_ATTACHMENT_BYTES=104857600
