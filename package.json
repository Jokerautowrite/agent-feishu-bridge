{
  "name": "agent-feishu-bridge",
  "version": "1.0.0",
  "description": "把本机主流 AI Agent 接入飞书/Lark，提供流式卡片、项目绑定、审批、附件和多后端切换。",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jokerautowrite/agent-feishu-bridge.git"
  },
  "homepage": "https://github.com/Jokerautowrite/agent-feishu-bridge#readme",
  "bugs": {
    "url": "https://github.com/Jokerautowrite/agent-feishu-bridge/issues"
  },
  "type": "commonjs",
  "main": "src/index.js",
  "keywords": [
    "codex",
    "claude",
    "opencode",
    "openclaw",
    "hermes-agent",
    "grok",
    "gemini-cli",
    "agent",
    "feishu",
    "lark",
    "bot",
    "cli",
    "remote",
    "gateway"
  ],
  "files": [
    "bin",
    "docs",
    "install.ps1",
    "install.sh",
    "src",
    "CHANGELOG.md",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codex-im": "./bin/codex-im.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "feishu-bot": "node ./bin/codex-im.js",
    "check": "node ./scripts/check-js-syntax.js",
    "test:markdown": "node ./scripts/test-assistant-markdown.js",
    "test:card-content": "node ./scripts/test-card-reply-content.js",
    "test:log-level": "node ./scripts/test-log-level.js",
    "test:delivery-receipts": "node ./scripts/test-delivery-receipt-hook.js",
    "test:stale-turn-watchdog": "node ./scripts/test-stale-turn-watchdog.js",
    "test:active-turn-steer": "node ./scripts/test-active-turn-steer.js",
    "test:inbound-handler": "node ./scripts/test-inbound-handler.js",
    "test:feishu-connection-lifecycle": "node ./scripts/test-feishu-connection-lifecycle.js",
    "test:codex-context-progress": "node ./scripts/test-codex-context-progress.js",
    "test:codex-transport-failure": "node ./scripts/test-codex-transport-failure.js",
    "test:media": "node ./scripts/test-media-fixtures.js",
    "test:directives": "node ./scripts/test-outbound-directives.js",
    "test:command-docs": "node ./scripts/test-command-docs.js",
    "test:backend-registry": "node ./scripts/test-backend-registry.js",
    "test:bridge-message-context": "node ./scripts/test-bridge-message-context.js",
    "test:openclaw-adapter": "node ./scripts/test-openclaw-adapter.js",
    "test:hermes-adapter": "node ./scripts/test-hermes-adapter.js",
    "test:grok-adapter": "node ./scripts/test-grok-adapter.js",
    "test:claude-adapter": "node ./scripts/test-claude-adapter.js",
    "test:server-hardening": "node ./scripts/test-attachment-security.js && node ./scripts/test-session-store.js && node ./scripts/test-log-redaction.js && node ./scripts/test-runtime-config.js",
    "test:groups": "npm run test:group-service && npm run test:group-identity && npm run test:group-admin && npm run test:group-authz",
    "test:gemini-adapter": "node ./scripts/test-gemini-adapter.js",
    "test:card-authz": "node ./scripts/test-card-authz.js",
    "test:stop-card-action": "node ./scripts/test-stop-card-action.js",
    "test:group-service": "node ./scripts/test-group-service.js",
    "test:group-identity": "node ./scripts/test-group-identity.js",
    "test:group-admin": "node ./scripts/test-group-admin.js",
    "test:group-authz": "node ./scripts/test-group-authz.js",
    "privacy:scan": "node ./scripts/privacy-scan.js",
    "pack:dry-run": "npm pack --dry-run",
    "check:release": "npm run check && npm run test:markdown && npm run test:card-content && npm run test:log-level && npm run test:delivery-receipts && npm run test:inbound-handler && npm run test:feishu-connection-lifecycle && npm run test:codex-context-progress && npm run test:codex-transport-failure && npm run test:stale-turn-watchdog && npm run test:active-turn-steer && npm run test:media && npm run test:directives && npm run test:command-docs && npm run test:backend-registry && npm run test:bridge-message-context && npm run test:openclaw-adapter && npm run test:hermes-adapter && npm run test:grok-adapter && npm run test:claude-adapter && npm run test:gemini-adapter && npm run test:group-service && npm run test:group-identity && npm run test:group-admin && npm run test:group-authz && npm run test:card-authz && npm run test:stop-card-action && npm run test:server-hardening && npm run test:groups && npm run privacy:scan && npm audit --omit=dev && npm run pack:dry-run"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@opencode-ai/sdk": "^1.15.10",
    "axios": "^1.19.0",
    "dotenv": "^16.4.7",
    "ws": "^8.21.3"
  },
  "overrides": {
    "axios": "^1.19.0",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.5",
    "qs": "^6.16.0",
    "ws": "^8.21.3"
  }
}